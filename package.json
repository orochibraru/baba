{
	"name": "@orochibraru/baba",
	"module": "index.ts",
	"type": "module",
	"version": "1.0.18",
	"private": true,
	"scripts": {
		"dev": "DEFAULT_CONFIG_TEMPLATE=./config.example.json DEFAULT_CONFIG_PATH=./config.json BABA_CONFIG_PATH=./config.json bun run --hot ./src/index.ts start",
		"build": "bun run ./scripts/build.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"gen:schema": "bun run scripts/generate-schema.ts",
		"gen:docs": "bun run scripts/generate-docs.ts && biome format --write config.example.json",
		"gen": "bun run gen:schema && bun run gen:docs",
		"prepare": "husky",
		"check": "tsc --noEmit --project tsconfig.json",
		"release": "semantic-release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@loglayer/transport-pino": "^3.3.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"commander": "^15.0.0",
		"husky": "^9.1.7",
		"loglayer": "^9.4.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"semantic-release": "^25.0.8",
		"systeminformation": "^5.33.1",
		"testcontainers": "^12.1.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
